{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "outDir": "electron-dist",
    "rootDir": "electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0"
  },
  "include": ["electron/**/*"]
}
