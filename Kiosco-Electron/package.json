{
  "name": "kiosco-electron",
  "private": true,
  "version": "1.0.0",
  "main": "electron-dist/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json && wait-on http://localhost:5173 && electron .\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "dist": "npm run build && npm run electron:build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "electron-is-dev": "^3.0.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sweetalert2": "^11.26.24",
    "sweetalert2-react-content": "^5.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^3.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^2.0.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.0.0",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.kioscopro.app",
    "productName": "Kiosco Pro",
    "win": {
      "icon": "public/icon.png"
    }
  }
}
