<Window x:Class="KioscoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiosco Pro - Sistema de Ventas" Height="750" Width="1200" Background="#F5F5F5" 
        WindowStartupLocation="CenterScreen" MinHeight="600" MinWidth="900">
    
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl x:Name="MainTabs" Padding="0" Margin="0">
            <TabItem Header="VENTA" Background="#FFFFFF" FontSize="16" FontWeight="Bold">
                <Grid Margin="20" Background="#FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <Border Background="#2196F3" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="🔍 ESCANEAR PRODUCTOS" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock Text="Coloca el cursor en el campo y escanea el código de barras" Foreground="#E3F2FD" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBox x:Name="txtBarcodeVenta" Height="50" FontSize="18" VerticalContentAlignment="Center" 
                                 KeyDown="TxtBarcodeVenta_KeyDown" TextChanged="TxtBarcodeVenta_TextChanged" 
                                 BorderBrush="#BDBDBD" BorderThickness="1" Padding="12,0" Background="White" Foreground="#333"/>
                        
                        <ListBox x:Name="lstSuggestions" Height="150" Visibility="Collapsed" Margin="0,5,0,0" 
                                 SelectionChanged="LstSuggestions_SelectionChanged" Background="White" BorderBrush="#BDBDBD" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding PrecioEfectivo, StringFormat='$ {0:#,##0}'}" Foreground="#2196F3"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <TextBlock Text="PRODUCTOS EN CARRITO" FontWeight="Bold" Foreground="#333" FontSize="14" Margin="0,20,0,10"/>
                        <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15">
                            <DataGrid x:Name="dgCarrito" Height="350" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      GridLinesVisibility="Horizontal" RowHeight="40" FontSize="13" Background="White">
                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="Producto" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding CantidadTexto}" FontSize="11" Foreground="#757575" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="Precio" Binding="{Binding PrecioTexto}" Width="140"/>
                                    <DataGridTemplateColumn Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Click="BtnQuitar_Click" Background="#E53935" Foreground="White" Padding="5"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        
                        <Button Content="➕ AGREGAR PRODUCTO MANUAL" Click="BtnManualOpen_Click" Style="{StaticResource ModernButton}" Background="#7B1FA2"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel VerticalAlignment="Bottom">
                            <Border Background="#2E7D32" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="TOTAL A PAGAR" FontSize="13" Foreground="#C8E6C9" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="lblTotal" Text="$ 0" FontSize="48" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Artículos: " FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblItemCount" Text="0" FontSize="20" Foreground="#2196F3" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="CARGA DE PRODUCTOS" Background="#FFFFFF" FontSize="16" FontWeight="Bold">
                <ScrollViewer Background="#F5F5F5">
                    <StackPanel Margin="40" MaxWidth="600" HorizontalAlignment="Left">
                        <Border Background="#1976D2" CornerRadius="10" Padding="20" Margin="0,0,0,30">
                            <TextBlock Text="📦 CARGAR INVENTARIO" FontSize="24" FontWeight="ExtraBold" Foreground="White"/>
                        </Border>
                        <Border Background="White" CornerRadius="10" Padding="25" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Código de Barras" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtCargaBarcode" Height="40" Margin="0,0,0,18" LostFocus="TxtCargaBarcode_LostFocus" KeyDown="TxtCargaBarcode_KeyDown"/>
                                <TextBlock Text="Nombre del Producto" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtCargaNombre" Height="40" Margin="0,0,0,18"/>
                                <TextBlock Text="Categoría" FontWeight="Bold" Margin="0,0,0,8"/>

                                <Grid x:Name="gridSeleccionCategoria" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ComboBox x:Name="cbCargaCategoria" Grid.Column="0" Height="40" FontSize="14"
                                            DisplayMemberPath="Nombre" SelectedValuePath="Id" Padding="10,0"/>
                                            
                                    <Button Content="➕" Grid.Column="1" Width="40" Height="40" Margin="5,0,0,0"
                                            Click="BtnNuevaCategoria_Click" ToolTip="Crear nueva categoría"
                                            Background="#2196F3" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                </Grid>

                                <Grid x:Name="gridNuevaCategoria" Visibility="Collapsed" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="txtNuevaCategoriaNombre" Grid.Column="0" Height="40" FontSize="14"
                                            VerticalContentAlignment="Center" Padding="5"/>
                                            
                                    <Button Content="✓" Grid.Column="1" Width="40" Height="40" Margin="5,0,0,0"
                                            Click="BtnGuardarNuevaCategoria_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                                            
                                    <Button Content="✕" Grid.Column="2" Width="40" Height="40" Margin="5,0,0,0"
                                            Click="BtnCancelarNuevaCategoria_Click" Background="#F44336" Foreground="White" FontWeight="Bold"/>
                                </Grid>
                                
                                <TextBlock Text="Precio de Venta ($)" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtCargaPrecio" Height="40" Margin="0,0,0,18"/>
                                <TextBlock Text="Stock Inicial" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtCargaStock" Height="40" Margin="0,0,0,25" Text="0"/>
                                <Button Content="💾 GUARDAR PRODUCTO" Click="BtnGuardar_Click" Style="{StaticResource ModernButton}" Background="#2E7D32"/>
                                <TextBlock x:Name="lblCargaStatus" Text="Listo" Margin="0,15,0,0" FontStyle="Italic" Foreground="#666"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="INVENTARIO" Background="#FFFFFF" FontSize="16" FontWeight="Bold">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#FF9800" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <TextBlock Text="📋 GESTIÓN DE INVENTARIO" FontSize="24" FontWeight="ExtraBold" Foreground="White"/>
                    </Border>
                    <TextBox x:Name="txtBuscarInventario" Grid.Row="1" Height="35" FontSize="14" Margin="0,0,0,15" TextChanged="TxtBuscarInventario_TextChanged" Tag="Buscar..."/>
                    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
                        <DataGrid x:Name="dgInventario" IsReadOnly="False" SelectionUnit="Cell" SelectionMode="Single"
                                  AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="45" 
                                  PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                                  KeyDown="DgInventario_KeyDown"
                                  CellEditEnding="DgInventario_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Precio ($)" Binding="{Binding PrecioEfectivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='C'}" Width="120"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTemplateColumn Header="Acciones" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Eliminar" Click="BtnEliminarProducto_Click" Tag="{Binding Id}" 
                                                    Background="#F44336" Foreground="White" 
                                                    FontSize="12" Padding="5,2" Height="30" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="CAJA" Background="#FFFFFF" FontSize="16" FontWeight="Bold">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <Border Background="#4CAF50" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="EFECTIVO EN CAJA" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lblCajaEfectivo" Text="$ 0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2196F3" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="OTROS MEDIOS" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lblCajaOtros" Text="$ 0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#607D8B" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="TOTAL VENTAS" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lblCajaTotal" Text="$ 0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="💰 PAGO A PROVEEDORES" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        <Button Content="➖ REGISTRAR SALIDA" Click="BtnRegistrarSalida_Click" Background="#F44336" Foreground="White" Margin="20,0,0,0" Height="35" Padding="10,5"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="HISTORIAL DE VENTAS" FontWeight="Bold" Foreground="#333" FontSize="14" Margin="0,0,0,10"/>
                            <DataGrid x:Name="dgHistorialVentas" AutoGenerateColumns="False" CanUserAddRows="False" Height="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hora" Binding="{Binding Fecha, StringFormat='HH:mm'}" Width="80"/>
                                    <DataGridTextColumn Header="Método" Binding="{Binding MetodoPago}" Width="120"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='$ #,##0'}" Width="120"/>
                                    <DataGridTextColumn Header="Detalle" Binding="{Binding DetalleTexto}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ENTRADAS/SALIDAS" FontWeight="Bold" Foreground="#333" FontSize="13" Margin="0,0,0,10"/>
                                <DataGrid x:Name="dgMovimientos" AutoGenerateColumns="False" CanUserAddRows="False" Height="400">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hora" Binding="{Binding FechaTexto}" Width="50"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="70"/>
                                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="100"/>
                                        <DataGridTextColumn Header="Monto" Binding="{Binding MontoTexto}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Grid.Row="3" Content="🔒 CERRAR CAJA" Click="BtnCerrarCaja_Click" Style="{StaticResource ModernButton}" Background="#E53935" Height="50" Margin="0,20,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="REPORTES" Background="#FFFFFF" FontSize="16" FontWeight="Bold">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#673AB7" CornerRadius="10" Padding="20" Margin="0,0,0,10">
                        <TextBlock Text="📂 HISTORIAL DE CIERRES" FontSize="24" FontWeight="ExtraBold" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="1" Background="#EDE7F6" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="RECAUDACIÓN TOTAL ACUMULADA: " VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock x:Name="lblRecaudacionTotalHistorica" Text="$ 0" FontSize="22" FontWeight="ExtraBold" Foreground="#311B92" Margin="10,0,0,0"/>
                            <ComboBox x:Name="cbReportScope" Width="150" Margin="20,0,0,0" SelectedIndex="0">
                                <ComboBoxItem>Detalle</ComboBoxItem>
                                <ComboBoxItem>Mensual</ComboBoxItem>
                                <ComboBoxItem>Anual</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="2" x:Name="dgHistorialCierres" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cierre" Binding="{Binding FechaCierre, StringFormat='dd/MM/yyyy HH:mm', Mode=OneWay}" Width="200"/>
                            <DataGridTextColumn Header="Efectivo" Binding="{Binding MontoFinalEfectivo, StringFormat='$ #,##0', Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Otros" Binding="{Binding MontoFinalOtros, StringFormat='$ #,##0', Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalDia, StringFormat='$ #,##0', Mode=OneWay}" Width="*" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="CLIENTES / FIADOS" Background="#FFFFFF" FontSize="16" FontWeight="Bold">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>     <ColumnDefinition Width="350"/>   </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="👥 Lista de Clientes" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <DataGrid x:Name="dgClientes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                                SelectionMode="Single" SelectionChanged="DgClientes_SelectionChanged"
                                HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" FontSize="16"/>
                                <DataGridTextColumn Header="Deuda ($)" Binding="{Binding Saldo, StringFormat=C}" Width="120" FontSize="16" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <TextBlock Text="➕ Nuevo Cliente" FontSize="18" FontWeight="Bold" Foreground="#673AB7" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtNombreCliente" FontSize="16" Padding="5" Tag="Nombre y Apellido"/>
                            <Button Content="Crear Cliente" Click="BtnCrearCliente_Click" Background="#673AB7" Foreground="White" Margin="0,10,0,30" Height="35">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>

                            <Separator Margin="0,0,0,20"/>

                            <StackPanel x:Name="panelDeuda" Visibility="Collapsed">
                                <TextBlock x:Name="lblClienteSeleccionado" Text="Seleccionado: Juan Perez" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" TextAlignment="Center"/>
                                
                                <TextBlock Text="Monto:" FontSize="14" Foreground="Gray"/>
                                <TextBox x:Name="txtMontoFiado" FontSize="20" Padding="5" HorizontalContentAlignment="Center" PreviewTextInput="TxtGramosPeso_PreviewTextInput" Margin="0,0,0,10"/>

                                <TextBlock Text="Método de Pago:" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cbMetodoPagoCobro" FontSize="14" Padding="8" SelectedIndex="0" Margin="0,0,0,15">
                                    <ComboBoxItem Content="Efectivo"/>
                                    <ComboBoxItem Content="Débito"/>
                                    <ComboBoxItem Content="Crédito"/>
                                    <ComboBoxItem Content="QR / Transferencia"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button Grid.Column="0" Content="FIAR (+)" Click="BtnFiar_Click" Background="#F44336" Foreground="White" Height="50" Margin="0,0,5,0" FontSize="16" FontWeight="Bold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                    
                                    <Button Grid.Column="1" Content="PAGAR (-)" Click="BtnPagarDeuda_Click" Background="#4CAF50" Foreground="White" Height="50" Margin="5,0,0,0" FontSize="16" FontWeight="Bold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            
                            <TextBlock x:Name="lblInfoSeleccion" Text="👈 Seleccioná un cliente de la lista para gestionar su deuda." 
                                    TextWrapping="Wrap" Foreground="Gray" Margin="0,20,0,0" FontStyle="Italic" HorizontalAlignment="Center"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid x:Name="gridApertura" Visibility="Collapsed" Background="#CC000000">
            <Border Background="White" Width="380" CornerRadius="16" VerticalAlignment="Center" Padding="35">
                <StackPanel>
                    <TextBlock Text="💰 APERTURA DE CAJA" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBox x:Name="txtMontoInicial" FontSize="28" Height="60" Text="0" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#2196F3" BorderThickness="2"/>
                    <Button Content="ABRIR TURNO" Click="BtnAbrirCaja_Click" Style="{StaticResource ModernButton}" Background="#4CAF50" Margin="0,20,0,0" Height="50"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="gridManual" Visibility="Collapsed" Background="#CC000000">
            <Border Background="White" Width="400" CornerRadius="16" VerticalAlignment="Center" Padding="30">
                <StackPanel>
                    <TextBlock Text="➕ PRODUCTO MANUAL" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox x:Name="txtManualNombre" Height="40" Margin="0,0,0,15" Tag="Nombre..."/>
                    <TextBox x:Name="txtManualPrecio" Height="40" Margin="0,0,0,25" Tag="Precio ($)..."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="BtnManualCancel_Click" Margin="0,0,10,0" Width="100"/>
                        <Button Content="Agregar" Click="BtnManualConfirm_Click" Style="{StaticResource ModernButton}" Background="#4CAF50" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="gridCobro" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="Black" Opacity="0.6" MouseDown="BtnCancelCobro_Click"/>

            <Border Background="White" Width="400" CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center" Margin="30">
                    <TextBlock Text="Cobrar Venta" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <Border Background="#E8F5E9" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Total a Pagar" FontSize="14" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblTotalCobro" Text="$ 0.00" FontSize="36" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Método de Pago:" FontSize="14" Foreground="#666" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbMetodoPago" FontSize="16" Padding="10" SelectedIndex="0" Margin="0,0,0,15">
                        <ComboBoxItem Content="Efectivo"/>
                        <ComboBoxItem Content="Débito"/>
                        <ComboBoxItem Content="Crédito"/>
                        <ComboBoxItem Content="QR / Transferencia"/>
                    </ComboBox>

                    <CheckBox x:Name="chkImprimirTicket" Content="🖨️ Imprimir Ticket" 
                            FontSize="16" Margin="0,5,0,15" 
                            HorizontalAlignment="Center" Cursor="Hand"/>

                    <TextBlock Text="Paga con:" FontSize="18" Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPagaCon" FontSize="28" Height="50" TextAlignment="Center" Margin="0,0,0,10"
                            TextChanged="TxtPagaCon_TextChanged" KeyDown="TxtPagaCon_KeyDown"
                            PreviewTextInput="TxtGramosPeso_PreviewTextInput"/>

                    <Border x:Name="borderErrorPago" Background="#FFEBEE" CornerRadius="8" Padding="12" Margin="0,0,0,15" Visibility="Collapsed">
                        <TextBlock x:Name="lblErrorPago" Text="❌ No alcanza el dinero" TextWrapping="Wrap" TextAlignment="Center" Foreground="#D32F2F" FontSize="14" FontWeight="Bold"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <TextBlock Text="Su Vuelto: " FontSize="20" Foreground="#666"/>
                        <TextBlock x:Name="lblVuelto" Text="$ 0.00" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Content="Cancelar (Esc)" Click="BtnCancelCobro_Click" Height="45" Background="#FFEBEE" Foreground="#D32F2F" BorderThickness="0" FontSize="16" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        
                        <Button Grid.Column="2" Content="COBRAR (Enter)" Click="BtnConfirmarVenta_Click" Height="45" Background="#4CAF50" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="gridPeso" Visibility="Collapsed" Background="#AA000000" KeyDown="GridPeso_KeyDown">
            <Border Background="White" Width="350" CornerRadius="12" VerticalAlignment="Center" Padding="25">
                <StackPanel>
                    <TextBlock Text="⚖️ INGRESAR PESO" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock x:Name="lblProductoPeso" Text="Producto: " FontSize="14" Margin="0,0,0,15"/>
                    <TextBlock Text="Gramos:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtGramosPeso" Height="40" FontSize="18" VerticalContentAlignment="Center" Margin="0,0,0,20" PreviewTextInput="TxtGramosPeso_PreviewTextInput"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="✓ ACEPTAR" Click="BtnAceptarPeso_Click" Width="100" Height="40" Margin="0,0,15,0" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                        <Button Content="✗ CANCELAR" Click="BtnCancelarPeso_Click" Width="100" Height="40" Background="#F44336" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        
        <Grid x:Name="gridCustomAlert" Visibility="Collapsed" Panel.ZIndex="999">
            <Border Background="Black" Opacity="0.4" MouseDown="BtnCerrarAlerta_Click"/>

            <Border Background="White" Width="400" CornerRadius="15" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

                    <TextBlock Text="⚠️" FontSize="40" HorizontalAlignment="Center" Foreground="#FFC107"/>

                    <TextBlock Grid.Row="1" Text="¡Atención!" FontSize="22" FontWeight="Bold" 
                            HorizontalAlignment="Center" Margin="0,10,0,5" Foreground="#333"/>

                    <TextBlock x:Name="txtAlertMessage" Grid.Row="2" 
                            Text="Aquí va el error..." 
                            TextWrapping="Wrap" TextAlignment="Center" 
                            FontSize="14" Foreground="#666"/>

                    <Button Grid.Row="3" Content="Entendido" Click="BtnCerrarAlerta_Click"
                            Margin="0,20,0,0"
                            Width="120" Height="35" Background="#F44336" Foreground="White"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

        </Grid>
        


        <Grid x:Name="gridConfirmDelete" Visibility="Collapsed" Panel.ZIndex="1001">
            <Border Background="Black" Opacity="0.5" MouseDown="BtnCancelarEliminar_Click"/>
            
            <Border Background="White" Width="380" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="🗑️" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="¿Eliminar Producto?" FontSize="20" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" Grid.Row="1"/>
                    
                    <TextBlock x:Name="lblMensajeEliminar" Grid.Row="2" 
                            Text="Se borrará 'Queso' permanentemente." 
                            TextWrapping="Wrap" TextAlignment="Center" 
                            Margin="0,15,0,20" FontSize="14" Foreground="#555"/>
                    
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Cancelar" Click="BtnCancelarEliminar_Click" 
                                Width="100" Height="35" Background="#EEE" Foreground="#333" Margin="0,0,15,0" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        
                        <Button Content="¡Sí, Borrar!" Click="BtnConfirmarEliminar_Click" 
                                Width="120" Height="35" Background="#D32F2F" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="gridMovimiento" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="Black" Opacity="0.5" MouseDown="BtnCancelarMovimiento_Click"/>
            
            <Border Background="White" Width="420" CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock x:Name="lblTituloMovimiento" Text="💰 REGISTRAR MOVIMIENTO" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <TextBlock Grid.Row="1" Text="Categoría:" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ComboBox Grid.Row="2" x:Name="cbCategoriaMov" FontSize="14" Height="38" Margin="0,0,0,15">
                        <ComboBoxItem Content="Pago a Proveedor"/>
                        <ComboBoxItem Content="Extracción Personal"/>
                        <ComboBoxItem Content="Cambio Banco"/>
                        <ComboBoxItem Content="Compra Artículos"/>
                        <ComboBoxItem Content="Otro"/>
                    </ComboBox>
                    
                    <TextBlock Grid.Row="3" Text="Monto ($):" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="4" x:Name="txtMontoMov" FontSize="18" Height="40" TextAlignment="Center" PreviewTextInput="TxtGramosPeso_PreviewTextInput" Margin="0,0,0,15"/>
                    
                    <TextBlock Grid.Row="5" Text="Descripción (opcional):" FontSize="13" Foreground="#777" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDescripcionMov" FontSize="12" Height="60" TextWrapping="Wrap" Margin="0,0,0,20" Padding="8"/>
                    
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Cancelar" Click="BtnCancelarMovimiento_Click" Width="110" Height="40" Background="#EEE" Foreground="#555" Margin="0,0,10,0" BorderThickness="0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button Content="Guardar" Click="BtnGuardarMovimiento_Click" Width="110" Height="40" Background="#4CAF50" Foreground="White" BorderThickness="0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>