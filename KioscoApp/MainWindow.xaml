<Window x:Class="KioscoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiosco Pro - Sistema de Ventas" Height="750" Width="1200" Background="#F5F5F5" 
        WindowStartupLocation="CenterScreen" MinHeight="600" MinWidth="900">
    
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl x:Name="MainTabs" Padding="0" Margin="0">
            <TabItem Header="VENTA (F1)" Background="#FFFFFF" FontSize="16" FontWeight="Bold">
                <Grid Margin="20" Background="#FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <Border Background="#2196F3" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="🔍 ESCANEAR PRODUCTOS" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock Text="Coloca el cursor en el campo y escanea el código de barras" Foreground="#E3F2FD" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBox x:Name="txtBarcodeVenta" Height="50" FontSize="18" VerticalContentAlignment="Center" 
                                 KeyDown="TxtBarcodeVenta_KeyDown" TextChanged="TxtBarcodeVenta_TextChanged" 
                                 BorderBrush="#BDBDBD" BorderThickness="1" Padding="12,0" Background="White" Foreground="#333"/>
                        
                        <ListBox x:Name="lstSuggestions" Height="150" Visibility="Collapsed" Margin="0,5,0,0" 
                                 SelectionChanged="LstSuggestions_SelectionChanged" Background="White" BorderBrush="#BDBDBD" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Precio, StringFormat='$ {0:F2}'}" Foreground="#2196F3"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <TextBlock Text="PRODUCTOS EN CARRITO" FontWeight="Bold" Foreground="#333" FontSize="14" Margin="0,20,0,10"/>
                        <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15">
                            <DataGrid x:Name="dgCarrito" Height="350" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      GridLinesVisibility="Horizontal" RowHeight="40" FontSize="13" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat='$ #,##0.00'}" Width="120"/>
                                    <DataGridTemplateColumn Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Click="BtnQuitar_Click" Background="#E53935" Foreground="White" Padding="5"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        
                        <Button Content="➕ AGREGAR PRODUCTO MANUAL" Click="BtnManualOpen_Click" Height="45" 
                                Background="#7B1FA2" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel VerticalAlignment="Bottom">
                            <Border Background="#2E7D32" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="TOTAL A PAGAR" FontSize="13" Foreground="#C8E6C9" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="lblTotal" Text="$ 0.00" FontSize="48" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Articulos: " FontWeight="Bold" Foreground="#555"/>
                            <TextBlock x:Name="lblItemCount" Text="0" FontSize="20" Foreground="#2196F3" FontWeight="Bold" Margin="0,0,0,15"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="CARGA DE PRODUCTOS" Background="#FFFFFF" FontSize="16" FontWeight="Bold">
                <ScrollViewer Background="#F5F5F5">
                    <StackPanel Margin="40" MaxWidth="600" HorizontalAlignment="Left">
                        <Border Background="#1976D2" CornerRadius="10" Padding="20" Margin="0,0,0 = 30">
                            <StackPanel>
                                <TextBlock Text="📦 CARGAR INVENTARIO" FontSize="24" FontWeight="ExtraBold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" Padding="25" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Código de Barras" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtCargaBarcode" Height="40" Margin="0,0,0,18" LostFocus="TxtCargaBarcode_LostFocus" KeyDown="TxtCargaBarcode_KeyDown"/>
                                
                                <TextBlock Text="Nombre del Producto" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtCargaNombre" Height="40" Margin="0,0,0,18"/>
                                
                                <TextBlock Text="Precio de Venta ($ ARS)" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtCargaPrecio" Height="40" Margin="0,0,0,18"/>

                                <TextBlock Text="Stock Inicial" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtCargaStock" Height="40" Margin="0,0,0,25" Text="0"/>
                                
                                <Button Content="💾 GUARDAR EN BASE DE DATOS" Click="BtnGuardar_Click" Height="50" Background="#2E7D32" Foreground="White" FontWeight="Bold"/>
                                <TextBlock x:Name="lblCargaStatus" Text="Estado: Esperando..." Margin="0,15,0,0" FontStyle="Italic" Foreground="#666"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="INVENTARIO" Background="#FFFFFF" FontSize="16" FontWeight="Bold">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#FF9800" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="📋 GESTIÓN DE INVENTARIO" FontSize="24" FontWeight="ExtraBold" Foreground="White"/>
                            <TextBlock Text="Lista completa de productos sincronizada con MySQL" FontSize="12" Foreground="#FFF3E0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
                        <DataGrid x:Name="dgInventario" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  GridLinesVisibility="Horizontal" RowHeight="45" FontSize="14" 
                                  Background="White" BorderThickness="0" AlternatingRowBackground="#F9F9F9"
                                  CellEditEnding="DgInventario_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat='$ #,##0.00'}" Width="120"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
                                <DataGridTemplateColumn Header="Estado" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#4CAF50"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Stock}" Value="0">
                                                                <Setter Property="Fill" Value="#F44336"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid x:Name="gridManual" Visibility="Collapsed" Background="#CC000000">
            <Border Background="White" Width="400" CornerRadius="16" VerticalAlignment="Center" Padding="30">
                <StackPanel>
                    <TextBlock Text="➕ PRODUCTO MANUAL" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox x:Name="txtManualNombre" Height="40" Margin="0,0,0,15" BorderBrush="#BDBDBD" Padding="10,5" Tag="Descripción"/>
                    <TextBox x:Name="txtManualPrecio" Height="40" Margin="0,0,0,25" BorderBrush="#BDBDBD" Padding="10,5" Tag="Precio"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="BtnManualCancel_Click" Margin="0,0,10,0" Width="80"/>
                        <Button Content="Agregar" Click="BtnManualConfirm_Click" Background="#4CAF50" Foreground="White" Width="80"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="gridCobro" Visibility="Collapsed" Background="#CC000000" KeyDown="GridCobro_KeyDown">
            <Border Background="White" Width="420" CornerRadius="16" VerticalAlignment="Center" Padding="35">
                <StackPanel>
                    <TextBlock Text="💳 COBRAR VENTA" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0 = 25"/>
                    <Border Background="#2E7D32" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                        <TextBlock x:Name="lblTotalCobro" FontSize="40" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <ComboBox x:Name="cbMetodoPago" Height="40" Margin="0,0,0,15" SelectedIndex="0" SelectionChanged="CbMetodoPago_SelectionChanged">
                        <ComboBoxItem Content="Efectivo"/>
                        <ComboBoxItem Content="Tarjeta de Débito"/>
                        <ComboBoxItem Content="Tarjeta de Crédito"/>
                        <ComboBoxItem Content="Transferencia"/>
                    </ComboBox>
                    <TextBlock x:Name="lblPagaCon" Text="Paga con ($)" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPagaCon" FontSize="28" Height="55" Margin="0,0,0,20" TextChanged="TxtPagaCon_TextChanged" KeyDown="TxtPagaCon_KeyDown"/>
                    <TextBlock x:Name="lblVuelto" Text="$ 0.00" FontSize="36" Foreground="#D32F2F" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="✓ FINALIZAR" Click="BtnConfirmarVenta_Click" Height="50" Background="#4CAF50" Foreground="White"/>
                    <Button Content="← VOLVER" Click="BtnCancelCobro_Click" Height="45" Background="#E53935" Foreground="White" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>