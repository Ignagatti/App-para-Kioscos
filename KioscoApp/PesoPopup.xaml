<Window x:Class="KioscoApp.PesoPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingresar Peso" Height="220" Width="350" WindowStartupLocation="CenterOwner"
        Background="#F0F0F0" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Producto por kilo" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        <TextBlock x:Name="lblProducto" Grid.Row="1" Text="Producto: " FontSize="14" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="2" Text="Ingrese los gramos:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox x:Name="txtGramos" Grid.Row="3" Height="35" FontSize="16" VerticalContentAlignment="Center"
                 Margin="0,0,0,15" PreviewTextInput="TxtGramos_PreviewTextInput" BorderBrush="#CCCCCC" BorderThickness="1"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Button Content="Aceptar" Click="BtnAceptar_Click" Width="80" Height="30" Margin="0,0,15,0" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button Content="Cancelar" Click="BtnCancelar_Click" Width="80" Height="30" Background="#F44336" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>